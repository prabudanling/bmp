generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin / pemilik toko / analis SEO yang bisa login ke dashboard
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  name      String
  role      String   @default("ADMIN") // ADMIN | SEO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kategori produk (Kompresor AC, Kapasitor, dll)
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String    @default("package")
  createdAt DateTime  @default(now())
  products  Product[]
}

// Produk kompresor & sparepart AC
model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  sku         String?
  brand       String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price       Int? // dalam Rupiah, null = harga on request
  unit        String    @default("pcs")
  stock       Int       @default(0)
  shortDesc   String?
  description String    @default("")
  specs       String    @default("[]") // JSON array [{k,v}]
  images      String    @default("[]") // JSON array url gambar
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

// Halaman konten CMS (Tentang Kami, FAQ, Kebijakan, dll) - seperti wp_posts
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("") // HTML dari editor WYSIWYG
  excerpt     String   @default("")
  isPublished Boolean  @default(true)
  showInMenu  Boolean  @default(false)
  sortOrder   Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pesan dari form kontak pelanggan
model Message {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Pengaturan toko (nama, WA, alamat, dll) - key/value
model Setting {
  key   String @id
  value String
}

// ============================================================
// SEO COMMAND CENTER — Super VVIP
// ============================================================

// Meta tag per halaman (dipakai layout SSR + preview SERP)
model SeoPageMeta {
  id          String   @id @default(cuid())
  routePath   String   @unique // "/", "/katalog", "/kontak", "/p/faq", ...
  title       String   @default("")
  description String   @default("")
  keywords    String   @default("") // dipisah koma
  ogImage     String   @default("")
  robots      String   @default("index,follow")
  priority    Float    @default(0.5) // prioritas sitemap 0.0 - 1.0
  updatedAt   DateTime @updatedAt
}

// Pelacakan posisi keyword di Google
model SeoKeyword {
  id           String   @id @default(cuid())
  keyword      String   @unique
  targetUrl    String   @default("/")
  position     Int? // posisi terkini (null = belum terdata)
  bestPosition Int?
  volume       Int      @default(0) // estimasi pencarian/bulan
  history      String   @default("[]") // JSON [{d: iso, p: pos}]
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Temuan audit SEO otomatis
model SeoIssue {
  id        String   @id @default(cuid())
  type      String // missing-desc, no-image, thin-content, meta-title, ...
  severity  String   @default("WARNING") // CRITICAL | WARNING | INFO
  title     String
  detail    String   @default("")
  target    String   @default("") // path atau nama produk
  status    String   @default("OPEN") // OPEN | FIXED | IGNORED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Jejak aktivitas eksklusif VVIP
model SeoEvent {
  id        String   @id @default(cuid())
  actor     String   @default("")
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
